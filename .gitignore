build/
*.xcodeproj
!Probe/project.yml
# The tap runner's project is committed (made by xcodegen from Tap/project.yml; CI checks it matches), and so are its
# copies in the skill and the plugin, so a person builds it with xcodebuild alone
!DuoTap.xcodeproj/
# ...but not what Xcode adds to it when it opens or builds it (CI compares the project with xcodegen's)
IDEWorkspaceChecks.plist
.build/
DerivedData/
*.png.tmp
.DS_Store

__pycache__/

# Xcode and SwiftPM per-user state, and local tool settings
.swiftpm/
xcuserdata/
*.xcresult
.claude/settings.local.json

# The evidence lives in 3nchiridion/foldsmith-evidence (beside this checkout); never commit it here
/raw/
/verification/
/evidence/
# A migration's progress and captures, when the skill runs in this folder
.duo/

# Launch drafts the owner reviews and posts himself; never committed
/docs/launch/
