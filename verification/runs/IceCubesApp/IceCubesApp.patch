diff --git a/Packages/DesignSystem/Sources/DesignSystem/Duo/FoldAwareSheetPlacement.swift b/Packages/DesignSystem/Sources/DesignSystem/Duo/FoldAwareSheetPlacement.swift
new file mode 100644
index 0000000..44925fd
--- /dev/null
+++ b/Packages/DesignSystem/Sources/DesignSystem/Duo/FoldAwareSheetPlacement.swift
@@ -0,0 +1,86 @@
+// FoldAwareSheetPlacement.swift — the sheet rule of duo-patterns' P1 "Fold-aligned split"
+// (patterns/fold-aligned-split.md; adapted from its reference implementation, FoldAlignedSplit.swift).
+//
+// Ice Cubes' split on iPhone Duo's inner display is the system tab sidebar, which already ends at the fold when the
+// phone is folded like a book and starts the tab's content after it. What it does not do is move sheets: the system
+// places them on the leading half while the book fold is active, ending inside the fold's margin (taxonomy T15),
+// where Apple sends alerts and sheets to the trailing side [tech talk 111463, 4:00].
+//
+// `readsBookFold()`, once on the window's root view, reads the fold from reserved regions (never from the device,
+// idiom or orientation) and tells every view below it, presented sheets included, whether a vertical fold is active.
+// `foldAwareSheetPlacement()` on a sheet's content then puts the sheet on the trailing half while it is, and leaves the
+// system's placement everywhere else (flat, upright, the outer display, any other device).
+//
+// iOS 27.1 and later, outside Mac Catalyst: `PresentationPlacement.trailing` is unavailable on visionOS and macOS, and
+// reserved regions arrive with iOS 27.1. Elsewhere both modifiers return the view unchanged.
+
+import SwiftUI
+
+public extension EnvironmentValues {
+  /// True while a vertical division is active around this view: the device is folded like a book.
+  @Entry var duoBookFoldIsActive: Bool = false
+}
+
+public extension View {
+  /// Apply once, on the window's root view: sets `duoBookFoldIsActive` for everything below it, sheets included.
+  @ViewBuilder func readsBookFold() -> some View {
+    #if os(iOS) && !targetEnvironment(macCatalyst)
+      if #available(iOS 27.1, *) {
+        modifier(BookFoldReader())
+      } else {
+        self
+      }
+    #else
+      self
+    #endif
+  }
+
+  /// Apply to a sheet's content: trailing half while the book fold is active, the system's placement otherwise.
+  @ViewBuilder func foldAwareSheetPlacement() -> some View {
+    #if os(iOS) && !targetEnvironment(macCatalyst)
+      if #available(iOS 27.1, *) {
+        modifier(FoldAwareSheetPlacement())
+      } else {
+        self
+      }
+    #else
+      self
+    #endif
+  }
+}
+
+#if os(iOS) && !targetEnvironment(macCatalyst)
+  @available(iOS 27.1, *)
+  private struct BookFoldReader: ViewModifier {
+    /// The active vertical fold in window coordinates, or nil.
+    @State private var fold: CGRect?
+
+    func body(content: Content) -> some View {
+      content
+        .environment(\.duoBookFoldIsActive, fold != nil)
+        .background {
+          GeometryReader { _ in
+            Color.clear.onGeometryChange(for: CGRect?.self, of: activeVerticalFold) { fold = $0 }
+          }
+          .ignoresSafeArea()
+        }
+    }
+  }
+
+  /// The first active division that runs top to bottom, in the proxy's coordinates (the window, here).
+  @available(iOS 27.1, *)
+  nonisolated private func activeVerticalFold(in proxy: GeometryProxy) -> CGRect? {
+    proxy.reservedRegions(kind: .division)  // active regions only
+      .map(\.frame)
+      .first { $0.height > $0.width }
+  }
+
+  @available(iOS 27.1, *)
+  private struct FoldAwareSheetPlacement: ViewModifier {
+    @Environment(\.duoBookFoldIsActive) private var foldIsActive
+
+    func body(content: Content) -> some View {
+      content.presentationPlacement(foldIsActive ? .trailing : .automatic)
+    }
+  }
+#endif
