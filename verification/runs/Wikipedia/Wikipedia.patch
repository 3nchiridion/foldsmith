+
+    /// iPhone Duo: true while this stack is a pane of a fold split (`WMFFoldSplitContainerViewController`).
+    ///
+    /// Each pane ends before the vertical bar's band (the list at the fold, the detail at the bar), but UIKit still gives
+    /// every screen of a navigation stack a trailing safe-area inset the width of the bar (84 pt) whenever the bar is on
+    /// that edge, wherever the stack is: the list's rows and controls stopped at 371 pt of a pane that ends at 455 pt,
+    /// and the article in the detail pane lost 84 pt of its 372. While this is set the inset is cancelled on each screen
+    /// of the stack (a negative `additionalSafeAreaInsets` on that edge) and given back when it is cleared, including to
+    /// a screen that moved to another stack meanwhile.
+    public var isFoldSplitPane = false {
+        didSet {
+            guard oldValue != isFoldSplitPane else { return }
+            view.setNeedsLayout()
+            updateVerticalBarInsetCancellation()
+        }
+    }
+
+    /// The trailing inset this class cancelled on each screen, so it can be given back exactly.
+    private static let cancelledVerticalBarInsets = NSMapTable<UIViewController, NSNumber>.weakToStrongObjects()
+
+    open override func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+        updateVerticalBarInsetCancellation()
+    }
+
+    /// iPhone Duo: on the list's stack of a split fold split container, a screen the container keeps for its detail
+    /// pane (an article) is shown there instead of being pushed here.
+    open override func pushViewController(_ viewController: UIViewController, animated: Bool) {
+        if isFoldSplitPane,
+           let container = parent as? WMFFoldSplitContainerViewController,
+           container.isSplit, container.listNavigationController === self,
+           container.routesToDetail(viewController) {
+            container.showDetail(viewController, animated: false)
+            return
+        }
+        super.pushViewController(viewController, animated: animated)
+    }
+
+    /// The screens whose trailing inset this stack corrects: its own, and what they present in their context (a search
+    /// controller's results), when that is drawn inside this stack.
+    private var screensInThisStack: [UIViewController] {
+        var screens: [UIViewController] = []
+        for viewController in viewControllers {
+            screens.append(viewController)
+            var presented = viewController.presentedViewController
+            while let current = presented, current.viewIfLoaded?.isDescendant(of: view) == true {
+                screens.append(current)
+                presented = current.presentedViewController
+            }
+        }
+        return screens
+    }
+
+    private func updateVerticalBarInsetCancellation() {
+        let trailingIsLeft = view.effectiveUserInterfaceLayoutDirection == .rightToLeft
+        for viewController in screensInThisStack {
+            let applied = CGFloat(Self.cancelledVerticalBarInsets.object(forKey: viewController)?.doubleValue ?? 0)
+            guard isFoldSplitPane || applied != 0 else {
+                continue
+            }
+            var additional = viewController.additionalSafeAreaInsets
+            let current = trailingIsLeft ? additional.left : additional.right
+            let safe = trailingIsLeft ? viewController.view.safeAreaInsets.left : viewController.view.safeAreaInsets.right
+            let system = max(0, safe - current)
+            let wanted: CGFloat = isFoldSplitPane ? -system : 0
+            guard wanted != applied else {
+                continue
+            }
+            let own = current - applied
+            if trailingIsLeft {
+                additional.left = own + wanted
+            } else {
+                additional.right = own + wanted
+            }
+            viewController.additionalSafeAreaInsets = additional
+            if wanted == 0 {
+                Self.cancelledVerticalBarInsets.removeObject(forKey: viewController)
+            } else {
+                Self.cancelledVerticalBarInsets.setObject(NSNumber(value: Double(wanted)), forKey: viewController)
+            }
+        }
+    }
