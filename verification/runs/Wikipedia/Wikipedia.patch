diff --git a/WMFComponents/Sources/WMFComponents/Utility/WMFFold.swift b/WMFComponents/Sources/WMFComponents/Utility/WMFFold.swift
new file mode 100644
index 0000000..9c6e12f
--- /dev/null
+++ b/WMFComponents/Sources/WMFComponents/Utility/WMFFold.swift
@@ -0,0 +1,85 @@
+import UIKit
+
+/// iPhone Duo: where the fold is, read from the window's reserved regions (iOS 27.1).
+///
+/// Layout reads the fold from reserved regions, never from the device, idiom or orientation. On an iPhone, an iPad,
+/// the Duo's outer display and any system before iOS 27.1 there is no division, so every answer here is "no fold"
+/// and callers keep their existing layout.
+///
+/// The fold is a *division* region: active while the phone is part folded (book, laptop, tent), inactive while it lies
+/// flat. Its frame already includes the 20 pt margins on either side of the crease (455.5–495.5 pt on the inner
+/// display). Regions arrive a moment after the first layout, so callers look again on layout and on hinge changes
+/// (`WMFFold.hingeInteraction`).
+///
+/// Patterns (duo-patterns): "Fold-aligned split" (sheets on the trailing half while the book fold is active) and
+/// "Even grid" (columns that keep clear of the fold, the inactive division included, so folding moves nothing).
+public enum WMFFold {
+
+    /// The division that runs top to bottom (the phone held sideways), in `view`'s coordinate space, or nil.
+    /// - Parameter includeInactive: also return it while the phone lies flat, for layouts that must not move when the
+    ///   phone is then folded.
+    public static func verticalDivision(in view: UIView, includeInactive: Bool) -> CGRect? {
+        guard #available(iOS 27.1, *) else {
+            return nil
+        }
+        let options: UIView.ReservedRegion.QueryOptions = includeInactive ? .includeInactive : []
+        return view.reservedRegions(kind: .division, options: options)
+            .filter { includeInactive || $0.isActive }
+            .map(\.frame)
+            .first { $0.height > $0.width }
+    }
+
+    /// True while the phone is folded like a book: a vertical division is active.
+    public static func isBookFoldActive(_ view: UIView) -> Bool {
+        return verticalDivision(in: view, includeInactive: false) != nil
+    }
+
+    /// An interaction that calls `onChange` whenever the hinge moves, so a view can look at the reserved regions again
+    /// (UIKit has no callback for the regions themselves). Nil before iOS 27.1.
+    public static func hingeInteraction(onChange: @escaping () -> Void) -> UIInteraction? {
+        guard #available(iOS 27.1, *) else {
+            return nil
+        }
+        return UIHingeInteraction { _, _ in
+            onChange()
+        }
+    }
+
+    // MARK: Sheets (Fold-aligned split, the sheet rule)
+
+    /// Sets a sheet's placement before it is presented over `view`: the trailing half while the book fold is active,
+    /// the system's own placement otherwise. Apple sends alerts and sheets to the trailing side in book; left alone the
+    /// system puts sheets on the leading half.
+    public static func prepareSheet(_ viewController: UIViewController, over view: UIView) {
+        guard #available(iOS 27.1, *) else {
+            return
+        }
+        // Only for sheets: asking a full-screen or popover presentation for its sheet controller is harmless, it is nil.
+        switch viewController.modalPresentationStyle {
+        case .pageSheet, .formSheet, .automatic:
+            viewController.sheetPresentationController?.preferredPlacement = isBookFoldActive(view) ? .trailing : .automatic
+        default:
+            break
+        }
+    }
+
+    /// Moves every sheet presented above `presenter` to the trailing half while the book fold is active, and back to the
+    /// system's placement otherwise. Call when the fold may have changed (layout, hinge).
+    public static func updateSheetPlacement(above presenter: UIViewController) {
+        guard #available(iOS 27.1, *) else {
+            return
+        }
+        let placement: UISheetPresentationController.Placement = isBookFoldActive(presenter.view) ? .trailing : .automatic
+        var presented = presenter.presentedViewController
+        while let viewController = presented {
+            if !viewController.isBeingDismissed,
+               let sheet = viewController.presentationController as? UISheetPresentationController,
+               sheet.preferredPlacement != placement {
+                sheet.animateChanges {
+                    sheet.preferredPlacement = placement
+                }
+            }
+            presented = viewController.presentedViewController
+        }
+    }
+}
