+++ b/WMFComponents/Sources/WMFComponents/Base/Component Base Classes/WMFFoldSplitContainerViewController.swift	
@@ -0,0 +1,286 @@
+import UIKit
+import Combine
+
+/// iPhone Duo, duo-patterns "Fold-aligned split" for a tab whose screen is a list that opens articles.
+///
+/// Wherever the window has a vertical division (the inner display held sideways: folded like a book, or lying flat),
+/// the tab shows two panes: its own navigation stack (the list) ends where the fold begins, and a detail stack starts
+/// where it ends, so neither pane straddles the fold. Opening an item from the list shows it in the detail pane.
+/// Everywhere else — the outer display, the inner display held upright (laptop, tent, flat upright), an iPhone, an
+/// iPad, any system before iOS 27.1 — there is no vertical division and the container is invisible: the tab's own
+/// navigation stack fills it, exactly as before.
+///
+/// Why not `UISplitViewController`: a split view expands wherever the width is regular, so it would also split the
+/// tab on an iPad and on the upright inner display, where the app has no finding and no split today. The panes here
+/// come only from the reserved regions, never from the device, idiom or orientation.
+///
+/// State survives the fold: closing the phone moves what the detail pane shows back onto the list's stack (the cover
+/// shows the article, Back returns to the list); opening it moves the detail screens (everything from the first one
+/// `isDetail` accepts) off the list's stack into the detail pane.
+public final class WMFFoldSplitContainerViewController: UIViewController {
+
+    public let listNavigationController: WMFComponentNavigationController
+    public let detailNavigationController: WMFComponentNavigationController
+    private let placeholder: UIViewController
+    private let isDetail: (UIViewController) -> Bool
+
+    /// True while the two panes are shown.
+    public private(set) var isSplit = false
+    private var division: CGRect?
+    private var didAddHingeInteraction = false
+    private var cancellables = Set<AnyCancellable>()
+
+    /// A screen shown in the list pane in place of the list while split (an article's contents beside the article).
+    public private(set) var listPaneAccessory: UIViewController?
+    /// The detail screen the accessory belongs to: it goes when another screen takes the detail pane.
+    private weak var listPaneAccessoryOwner: UIViewController?
+
+    /// - Parameters:
+    ///   - list: the tab's navigation controller, as the tab used it before.
+    ///   - placeholder: what the detail pane shows before anything is opened.
+    ///   - isDetail: which screens belong in the detail pane (articles).
+    public init(list: WMFComponentNavigationController, placeholder: UIViewController, isDetail: @escaping (UIViewController) -> Bool) {
+        self.listNavigationController = list
+        self.placeholder = placeholder
+        self.detailNavigationController = WMFComponentNavigationController(rootViewController: placeholder, modalPresentationStyle: .overFullScreen)
+        self.isDetail = isDetail
+        super.init(nibName: nil, bundle: nil)
+        tabBarItem = list.viewControllers.first?.tabBarItem ?? list.tabBarItem
+        title = list.viewControllers.first?.title
+        // The band behind the fold and behind the vertical bar shows the container's own background: follow the theme.
+        WMFAppEnvironment.publisher
+            .sink { [weak self] _ in self?.applyThemeBackground() }
+            .store(in: &cancellables)
+    }
+
+    private func applyThemeBackground() {
+        guard isViewLoaded else { return }
+        view.backgroundColor = WMFAppEnvironment.current.theme.paperBackground
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    /// The container holding `navigationController` as its list, or nil.
+    public static func containing(_ navigationController: UINavigationController) -> WMFFoldSplitContainerViewController? {
+        guard let container = navigationController.parent as? WMFFoldSplitContainerViewController,
+              container.listNavigationController === navigationController else {
+            return nil
+        }
+        return container
+    }
+
+    /// True when `viewController` is in the detail pane of a container that is split (a pane narrower than the outer
+    /// display: 372 pt in book). Screens use it where a regular width would otherwise give them a side column.
+    public static func isInSplitDetailPane(_ viewController: UIViewController) -> Bool {
+        guard let navigationController = viewController.navigationController,
+              let container = navigationController.parent as? WMFFoldSplitContainerViewController else {
+            return false
+        }
+        return container.isSplit && container.detailNavigationController === navigationController
+    }
+
+    /// The container whose detail pane (while split) holds `viewController`, or nil.
+    public static func containerOfDetailPane(holding viewController: UIViewController) -> WMFFoldSplitContainerViewController? {
+        guard let navigationController = viewController.navigationController,
+              let container = navigationController.parent as? WMFFoldSplitContainerViewController,
+              container.isSplit, container.detailNavigationController === navigationController else {
+            return nil
+        }
+        return container
+    }
+
+    /// Shows `viewController` in the detail pane, replacing what was there. Only while split.
+    public func showDetail(_ viewController: UIViewController, animated: Bool) {
+        setListPaneAccessory(nil) // what the previous detail showed in the list pane (its contents) goes with it
+        detailNavigationController.setViewControllers([viewController], animated: animated)
+    }
+
+    /// Whether a screen pushed on the list's stack belongs in the detail pane.
+    func routesToDetail(_ viewController: UIViewController) -> Bool {
+        return isDetail(viewController)
+    }
+
+    /// Back to the tab's root, as a tap on the W or on the tab did before: the list pops to its root and the detail
+    /// pane empties.
+    public func popToRoot(animated: Bool) {
+        setListPaneAccessory(nil)
+        listNavigationController.popToRootViewController(animated: animated)
+        if detailNavigationController.viewControllers.first !== placeholder {
+            detailNavigationController.setViewControllers([placeholder], animated: false)
+        }
+    }
+
+    /// True while split and the detail pane shows something other than its placeholder (an article, or a screen
+    /// opened from it).
+    public var detailShowsContent: Bool {
+        guard isSplit, let top = detailNavigationController.topViewController else {
+            return false
+        }
+        return top !== placeholder
+    }
+
+    /// The stack in front: the detail stack while it shows an article (what is opened from there stacks on it), else
+    /// the list's stack.
+    public var frontNavigationController: WMFComponentNavigationController {
+        return detailShowsContent ? detailNavigationController : listNavigationController
+    }
+
+    /// True when the tab is at its root: the list at its first screen and nothing in the detail pane.
+    public var isAtRoot: Bool {
+        return listNavigationController.viewControllers.count == 1 && !detailShowsContent
+    }
+
+    /// True while the detail pane shows a screen that hides the tab bar when pushed (an article). An open article hides
+    /// the tab bar on the outer display; it does the same beside the list, which leaves the vertical bar to its items.
+    public var detailHidesTabBar: Bool {
+        guard isSplit, let top = detailNavigationController.topViewController, top !== placeholder else {
+            return false
+        }
+        return top.hidesBottomBarWhenPushed
+    }
+
+    /// Shows `viewController` in the list pane in place of the list while split, or removes what is there (nil).
+    /// `owner` is the detail screen it belongs to; it is removed when another screen takes the detail pane.
+    public func setListPaneAccessory(_ viewController: UIViewController?, owner: UIViewController? = nil) {
+        if let current = listPaneAccessory, current !== viewController {
+            current.willMove(toParent: nil)
+            current.view.removeFromSuperview()
+            current.removeFromParent()
+            listPaneAccessory = nil
+            listPaneAccessoryOwner = nil
+        }
+        // What the accessory covers is not on screen: keep it out of VoiceOver and touch while it is covered.
+        listNavigationController.view.accessibilityElementsHidden = viewController != nil
+        guard let viewController, viewController !== listPaneAccessory else {
+            return
+        }
+        addChild(viewController)
+        view.insertSubview(viewController.view, aboveSubview: listNavigationController.view)
+        viewController.didMove(toParent: self)
+        listPaneAccessory = viewController
+        listPaneAccessoryOwner = owner
+        layoutPanes()
+    }
+
+    /// Called when the detail pane shows `viewController` (a push, a pop, a replacement): an accessory that belongs to
+    /// another screen goes. The screen that owns it puts it back when it is on top again.
+    public func detailDidShow(_ viewController: UIViewController) {
+        guard listPaneAccessory != nil, listPaneAccessoryOwner !== viewController else {
+            return
+        }
+        setListPaneAccessory(nil)
+    }
+
+    public override func viewDidLoad() {
+        super.viewDidLoad()
+        applyThemeBackground()
+        addChild(listNavigationController)
+        view.addSubview(listNavigationController.view)
+        listNavigationController.didMove(toParent: self)
+
+        addChild(detailNavigationController)
+        view.addSubview(detailNavigationController.view)
+        detailNavigationController.didMove(toParent: self)
+        detailNavigationController.view.isHidden = true
+        listNavigationController.view.frame = view.bounds
+    }
+
+    public override func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+        if !didAddHingeInteraction {
+            didAddHingeInteraction = true
+            if let hingeInteraction = WMFFold.hingeInteraction(onChange: { [weak self] in self?.view.setNeedsLayout() }) {
+                view.addInteraction(hingeInteraction)
+            }
+        }
+        let newDivision = WMFFold.verticalDivision(in: view, includeInactive: true)
+        let shouldSplit = newDivision.map { $0.minX > 0 && $0.maxX < view.bounds.width } ?? false
+        if shouldSplit != isSplit {
+            isSplit = shouldSplit
+            listNavigationController.isFoldSplitPane = shouldSplit
+            detailNavigationController.isFoldSplitPane = shouldSplit
+            if shouldSplit {
+                moveDetailScreensToDetailPane()
+            } else {
+                moveDetailScreensToList()
+            }
+            if #available(iOS 27.1, *) {
+                setNeedsUpdateOfVerticalBarConfiguration()
+            }
+        }
+        division = shouldSplit ? newDivision : nil
+        layoutPanes()
+    }
+
+    private func layoutPanes() {
+        let bounds = view.bounds
+        guard isSplit, let division else {
+            listNavigationController.view.frame = bounds
+            detailNavigationController.view.isHidden = true
+            listPaneAccessory?.view.isHidden = true
+            return
+        }
+        // The list ends where the fold begins; the detail starts where it ends and stops at the trailing safe area,
+        // so nothing of it runs under the system's vertical bar (whose band shows the container's background).
+        listNavigationController.view.frame = CGRect(x: bounds.minX, y: bounds.minY, width: floor(division.minX) - bounds.minX, height: bounds.height)
+        let detailX = ceil(division.maxX)
+        let detailMaxX = bounds.maxX - view.safeAreaInsets.right
+        detailNavigationController.view.frame = CGRect(x: detailX, y: bounds.minY, width: max(0, detailMaxX - detailX), height: bounds.height)
+        detailNavigationController.view.isHidden = false
+        if let accessory = listPaneAccessory {
+            accessory.view.frame = listNavigationController.view.frame
+            accessory.view.isHidden = false
+        }
+    }
+
+    /// Opening the phone: the detail screens on the list's stack move to the detail pane.
+    private func moveDetailScreensToDetailPane() {
+        let stack = listNavigationController.viewControllers
+        guard let first = stack.dropFirst().firstIndex(where: isDetail) else {
+            detailNavigationController.setViewControllers([placeholder], animated: false)
+            return
+        }
+        listNavigationController.setViewControllers(Array(stack[..<first]), animated: false)
+        detailNavigationController.setViewControllers(Array(stack[first...]), animated: false)
+        // The list's top screen changed without a transition: let its delegate set the bars up again.
+        if let top = listNavigationController.topViewController {
+            listNavigationController.delegate?.navigationController?(listNavigationController, didShow: top, animated: false)
+        }
+    }
+
+    /// Closing the phone: what the detail pane shows goes back on top of the list's stack.
+    private func moveDetailScreensToList() {
+        setListPaneAccessory(nil) // the list pane goes away; the screen that put something there takes it back
+        let moved = detailNavigationController.viewControllers.filter { $0 !== placeholder }
+        detailNavigationController.setViewControllers([placeholder], animated: false)
+        guard let top = moved.last else {
+            return
+        }
+        // Pushed, not set: a push applies the top screen's bar settings (an article hides the tab bar).
+        listNavigationController.setViewControllers(listNavigationController.viewControllers + moved.dropLast(), animated: false)
+        listNavigationController.pushViewController(top, animated: false)
+    }
+
+    // MARK: Bars and status bar
+
+    /// The vertical bar goes with the pane the system puts on the trailing side: the detail while split, the list
+    /// otherwise (the list keeps its bar at the top of its pane, as a split view's sidebar does).
+    @available(iOS 27.1, *)
+    public override var childForPreferredVerticalBarBehavior: UIViewController? {
+        return isSplit ? detailNavigationController : listNavigationController
+    }
+
+    public override var childForStatusBarStyle: UIViewController? {
+        return listNavigationController
+    }
+
+    public override var childForStatusBarHidden: UIViewController? {
+        return listNavigationController
+    }
+
+    public override var supportedInterfaceOrientations: UIInterfaceOrientationMask {
+        return listNavigationController.supportedInterfaceOrientations
+    }
+}
