diff --git a/WMFComponents/Sources/WMFComponents/Base/Component Base Classes/WMFFoldSplitContainerViewController.swift b/WMFComponents/Sources/WMFComponents/Base/Component Base Classes/WMFFoldSplitContainerViewController.swift
new file mode 100644
