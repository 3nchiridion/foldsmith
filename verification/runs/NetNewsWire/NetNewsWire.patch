+
+	/// Whether the column widths are currently left to the system because the window has a fold.
+	private var isFoldAligned: Bool?
+
+	override func viewDidLoad() {
+		super.viewDidLoad()
+		if #available(iOS 27.1, *) {
+			// The hinge only says when to look again; the layout comes from the reserved regions.
+			let hingeInteraction = UIHingeInteraction { [weak self] _, _ in
+				self?.view.setNeedsLayout()
+			}
+			view.addInteraction(hingeInteraction)
+		}
+	}
+
+	override func viewDidLayoutSubviews() {
+		super.viewDidLayoutSubviews()
+		updateForFold()
+	}
+
+	override func present(_ viewControllerToPresent: UIViewController, animated flag: Bool, completion: (() -> Void)? = nil) {
+		FoldAlignedSplit.prepareSheet(viewControllerToPresent, over: view)
+		super.present(viewControllerToPresent, animated: flag, completion: completion)
+	}
+
+	private func updateForFold() {
+		guard let coordinator else {
+			return
+		}
+		let hasFold = FoldAlignedSplit.hasFold(view)
+		if hasFold != isFoldAligned {
+			isFoldAligned = hasFold
+			coordinator.splitViewFoldDidChange(hasFold: hasFold)
+		}
+		FoldAlignedSplit.updateSheetPlacement(above: self)
+	}
