diff --git a/iOS/FoldAlignedSplit.swift b/iOS/FoldAlignedSplit.swift
new file mode 100644
index 0000000..39b2393
--- /dev/null
+++ b/iOS/FoldAlignedSplit.swift
@@ -0,0 +1,73 @@
+//
+//  FoldAlignedSplit.swift
+//  NetNewsWire-iOS
+//
+//  iPhone Duo: the duo-patterns "Fold-aligned split" (P1) for a UIKit split view.
+//
+//  On a display with a fold (iPhone Duo’s inner display) the split view sets no column width, so the system puts
+//  the boundary between its panes on the fold when the phone is folded like a book, as Settings does. Any width set
+//  by the app, even one equal to the fold’s edge, stops that and leaves the detail across the fold.
+//  Sheets move to the trailing half while the book fold is active; the system places them on the leading half,
+//  over the list, while Apple sends alerts and sheets to the trailing side in book. Everywhere else (iPhone, iPad,
+//  the Duo’s outer display, the Duo lying flat or standing upright) nothing changes.
+//
+//  The fold is read from reserved regions, never from the device, idiom or orientation. Inactive divisions count
+//  for the column widths so the layout does not change when a flat phone is folded.
+//
+
+import UIKit
+
+@MainActor enum FoldAlignedSplit {
+
+	/// True when the view’s window has a fold, active or not: the inner display of a folding iPhone.
+	static func hasFold(_ view: UIView) -> Bool {
+		guard #available(iOS 27.1, *) else {
+			return false
+		}
+		return !view.reservedRegions(kind: .division, options: .includeInactive).isEmpty
+	}
+
+	/// True while a division that runs top to bottom is active: the phone is folded like a book.
+	static func isBookFoldActive(_ view: UIView) -> Bool {
+		guard #available(iOS 27.1, *) else {
+			return false
+		}
+		return view.reservedRegions(kind: .division).contains { $0.isActive && $0.frame.height > $0.frame.width }
+	}
+
+	/// Sets a sheet’s placement before it is presented over `view`.
+	static func prepareSheet(_ viewController: UIViewController, over view: UIView) {
+		guard #available(iOS 27.1, *) else {
+			return
+		}
+		viewController.sheetPresentationController?.preferredPlacement = isBookFoldActive(view) ? .trailing : .automatic
+	}
+
+	/// Places every sheet presented above `presenter` on the trailing half while the book fold is active,
+	/// and leaves placement to the system otherwise.
+	static func updateSheetPlacement(above presenter: UIViewController) {
+		guard #available(iOS 27.1, *) else {
+			return
+		}
+		let placement: UISheetPresentationController.Placement = isBookFoldActive(presenter.view) ? .trailing : .automatic
+		var presented = presenter.presentedViewController
+		while let viewController = presented {
+			if let sheet = viewController.sheetPresentationController, sheet.preferredPlacement != placement {
+				sheet.animateChanges {
+					sheet.preferredPlacement = placement
+				}
+			}
+			presented = viewController.presentedViewController
+		}
+	}
+
+	/// Appended to the article style on a display with a fold: an empty detail’s placeholder (“No selection”)
+	/// sits in the upper part of its pane instead of at 45 % of its height, which is on the fold when the phone
+	/// stands upright, half open.
+	static let placeholderStyle = "\n.systemMessage { top: 25%; }\n"
+}
+
+extension Notification.Name {
+	/// Posted by `SceneCoordinator` when the window gains or loses a fold.
+	static let foldAlignmentDidChange = Notification.Name("FoldAlignmentDidChange")
+}
