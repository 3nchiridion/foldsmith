# NetNewsWire iOS on the iPhone Duo. Every launch starts at the feeds list (the app otherwise reopens the last feed
# and article). A fresh install asks for notifications at launch: springboard:Don declines it if it is up.
BUNDLE=com.ranchero.NetNewsWire.iOS-DEBUG
LAUNCH_ARGS="-selectedSidebarItem {} -selectedArticle {}"
SCREENS=(
  "feeds=springboard:Don"
  "timeline=springboard:Don;All Unread"
  "article=springboard:Don;All Unread;cell:1"
  "settings=springboard:Don;Settings"
  "add-feed=springboard:Don;Add;Add Feed"
)
