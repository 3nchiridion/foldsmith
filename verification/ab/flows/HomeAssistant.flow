# home-assistant/iOS at 3ef4355 (raw/corpus/manifest.txt), built as in raw/corpus/BUILDS.md (ad-hoc signed).
# The four screens Mac step 4 captured (invalid-url dropped: it showed no change from manual-url in any pose). A fresh
# install may ask for notifications at launch: every flow first declines it if it is up.
BUNDLE=dev.enchiridion.corpus.HomeAssistant.dev
SCREENS=(
  "launch=springboard:Don"                                     # Welcome
  "servers=springboard:Don;Connect"                            # Searching on home network (debug build's test servers)
  "manual-url=springboard:Don;Connect;Enter address manually"  # address sheet with the keyboard up
  "learn-more=springboard:Don;Learn more"                      # SFSafariViewController sheet
)
