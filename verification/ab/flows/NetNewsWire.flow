# NetNewsWire at d9ec7df (raw/corpus/manifest.txt), built as in raw/corpus/BUILDS.md (updateSecrets.sh with no keys).
# Its default feeds load from the network; the article is whatever is newest in Brent Simmons' "inessential" feed, so
# its text differs from day to day (raters judge layout only). A fresh install asks for notifications at launch:
# every flow first declines it if it is up. It reopens the last feed and article it showed (iOS/AppDefaults+iOS.swift,
# selectedSidebarItem and selectedArticle in UserDefaults); launch arguments override those two with empty values so
# every capture starts at the feeds list.
BUNDLE=com.ranchero.NetNewsWire.iOS-DEBUG
LAUNCH_ARGS="-selectedSidebarItem {} -selectedArticle {}"
SCREENS=(
  "launch=springboard:Don"                           # Feeds list
  "timeline=springboard:Don;inessential"             # one feed's articles
  "article=springboard:Don;inessential;cell:1"       # its newest article
  "settings=springboard:Don;Settings"                # Settings sheet
)
